# FortigiGraph Ingestion API - Environment Configuration
# Copy this file to .env and fill in the values

# ── Server ────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── Azure SQL Database ────────────────────────────────────────────────
# Connection string (preferred) or individual settings
SQL_CONNECTION_STRING=Server=yourserver.database.windows.net;Database=GraphData;...

# OR individual settings (used if SQL_CONNECTION_STRING is not set)
SQL_SERVER=yourserver.database.windows.net
SQL_DATABASE=GraphData
SQL_USER=youruser
SQL_PASSWORD=yourpassword
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERTIFICATE=false

# ── Azure AD Authentication ───────────────────────────────────────────
# Tenant ID of your Azure AD tenant
AZURE_TENANT_ID=your-tenant-id

# Client ID of the App Registration created for this API
# Callers must obtain tokens with scope: api://<AZURE_CLIENT_ID>/.default
AZURE_CLIENT_ID=your-api-client-id

# Set to 'false' to disable auth (development / demo only)
AUTH_ENABLED=true

# Optional: Comma-separated list of required app roles (leave empty to allow all authenticated callers)
# AUTH_REQUIRED_ROLES=Ingestion.Write,Ingestion.ReadWrite

# ── CORS ──────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (leave empty to deny all cross-origin)
# ALLOWED_ORIGINS=https://yourapp.example.com

# ── Rate Limiting ─────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=200

# ── Swagger UI ────────────────────────────────────────────────────────
SWAGGER_UI_ENABLED=true
