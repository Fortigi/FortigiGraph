# FortigiGraph UI Backend Configuration
# Copy this to .env and fill in your values

# Set to "true" to use real SQL connection, "false" for mock data
USE_SQL=false

# Azure SQL Connection (only needed when USE_SQL=true)
SQL_SERVER=sql-fortigraph-xxxxx.database.windows.net
SQL_DATABASE=GraphData
SQL_USER=sqladmin
SQL_PASSWORD=your-password-here

# Entra ID Authentication (set AUTH_ENABLED=true for production)
AUTH_ENABLED=false
AUTH_TENANT_ID=your-tenant-id
AUTH_CLIENT_ID=your-ui-app-client-id
# Optional: Comma-separated app roles required to access the API
# If not set, any valid token from the tenant is accepted
#AUTH_REQUIRED_ROLES=FortigiGraph.Read

# Server settings
PORT=3001

# CORS: Comma-separated list of allowed origins (required in production)
# Example: ALLOWED_ORIGINS=https://myapp.azurewebsites.net,https://myapp.example.com
# If not set: all origins allowed in development, none in production
#ALLOWED_ORIGINS=
