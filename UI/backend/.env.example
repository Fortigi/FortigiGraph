# FortigiGraph UI Backend Configuration
# Copy this to .env and fill in your values

# Set to "true" to use real SQL connection, "false" for mock data
USE_SQL=false

# Azure SQL Connection (only needed when USE_SQL=true)
SQL_SERVER=sql-fortigraph-xxxxx.database.windows.net
SQL_DATABASE=GraphData
SQL_USER=sqladmin
SQL_PASSWORD=your-password-here

# Server settings
PORT=3001
