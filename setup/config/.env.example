# FortigiGraph Docker — Local Environment Variables
# Copy to .env and fill in your values. Never commit .env to git.

# SQL Server (matches docker-compose.local.yml defaults)
SQL_PASSWORD=FortigiGraph_Local1!

# Crawler API key (generate via UI admin page or API after first start)
CRAWLER_API_KEY=fgc_your_key_here

# Microsoft Graph credentials (for EntraID crawler)
GRAPH_TENANT_ID=your-tenant-id
GRAPH_CLIENT_ID=your-client-id
GRAPH_CLIENT_SECRET=your-client-secret

# LLM credentials (for risk scoring — optional)
LLM_PROVIDER=Anthropic
LLM_API_KEY=your-anthropic-or-openai-key

# CSV import folder (mounted into the powershell container)
CSV_DATA_PATH=./_Test/DatasetLed2
