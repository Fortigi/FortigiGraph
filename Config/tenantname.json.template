{
  "_INFO": "Example Daily Sync configuration with Sync section configured",
  "_NOTE": "This shows how to configure sync settings in the config file",
  "_USAGE": "Copy this to config.production.json and customize for your environment",
  "Azure": {
    "TenantId": "yourtenant.onmicrosoft.com",
    "SubscriptionId": "your-subscription-id",
    "ResourceGroupName": "ResourceGroupName",
    "Location": "northeurope",
    "SQLServerName": "SQLServerName",
    "DatabaseName": "GraphData",
    "AdminUsername": "sqladmin",
    "AdminUserPassword": "",
    "AdminUserPassword_Encrypted": "",
    "AutomationAccountName": "aa-fortigraph"
  },
  "Graph": {
    "TenantId": "yourtenant.onmicrosoft.com",
    "ClientId": "your-clientid-guid",
    "ClientSecret": "your-client-secret"
  },
  "Sync": {
    "ScheduleTimeZone": "W. Europe Standard Time",
    "Users": {
      "Enabled": true,
      "Filter": "",
      "AdditionalAttributes": [
        "streetAddress",
        "usageLocation",
        "state"
      ],
      "Schedule": {
        "Enabled": true,
        "Time": "06:00",
        "Frequency": "Daily"
      }
    },
    "Groups": {
      "Enabled": true,
      "Filter": "",
      "Schedule": {
        "Enabled": true,
        "Time": "06:00",
        "Frequency": "Daily"
      }
    },
    "GroupMembers": {
      "Enabled": true,
      "Schedule": {
        "Enabled": true,
        "Time": "07:00",
        "Frequency": "Daily"
      }
    },
    "GroupEligibleMembers": {
      "Enabled": true,
      "_Comment": "PIM not configured in this environment"
    },
    "GroupOwners": {
      "Enabled": true
    },
    "Catalogs": {
      "Enabled": true,
      "Schedule": {
        "Enabled": true,
        "Time": "06:00",
        "Frequency": "Daily"
      }
    },
    "AccessPackages": {
      "Enabled": true,
      "Schedule": {
        "Enabled": true,
        "Time": "06:15",
        "Frequency": "Daily"
      }
    },
    "AccessPackageAssignments": {
      "Enabled": true,
      "Schedule": [
        { "Enabled": true, "Time": "06:00", "Frequency": "Daily" },
        { "Enabled": true, "Time": "12:00", "Frequency": "Daily" },
        { "Enabled": true, "Time": "18:00", "Frequency": "Daily" }
      ]
    },
    "AccessPackageResourceRoleScopes": {
      "Enabled": true
    },
    "AccessPackageAssignmentPolicies": {
      "Enabled": true
    },
    "AccessPackageAssignmentRequests": {
      "Enabled": true
    },
    "AccessPackageAccessReviews": {
      "Enabled": true
    },
    "_V3_NOTE": "The following sync types are part of the v3.0 Universal Resource Model. They populate the Systems, Resources, Principals, OrgUnits tables alongside the legacy GraphUsers/GraphGroups tables.",
    "Principals": {
      "Enabled": true,
      "_Comment": "Syncs Entra ID users to the Principals table (v3.0 universal model)",
      "Schedule": {
        "Enabled": true,
        "Time": "06:00",
        "Frequency": "Daily"
      }
    },
    "EntraDirectoryRoles": {
      "Enabled": true,
      "_Comment": "Syncs Entra ID directory roles and their members to Resources + ResourceAssignments",
      "Schedule": {
        "Enabled": true,
        "Time": "06:00",
        "Frequency": "Daily"
      }
    },
    "EntraAppRoleAssignments": {
      "Enabled": true,
      "_Comment": "Syncs app role assignments (enterprise app permissions) to Resources + ResourceAssignments",
      "Schedule": {
        "Enabled": true,
        "Time": "06:00",
        "Frequency": "Daily"
      }
    },
    "ResourceRelationships": {
      "Enabled": true,
      "_Comment": "Discovers and syncs resource-to-resource links (e.g. group grants access to app role)",
      "Schedule": {
        "Enabled": true,
        "Time": "08:00",
        "Frequency": "Daily"
      }
    },
    "OrgUnits": {
      "Enabled": true,
      "_Comment": "Calculates organisational units (departments/teams) from Principals data",
      "Schedule": {
        "Enabled": true,
        "Time": "08:30",
        "Frequency": "Daily"
      }
    },
    "Views": {
      "Enabled": true
    },
    "MaterializedViews": {
      "Enabled": true,
      "Schedule": {
        "Enabled": true,
        "Time": "10:00",
        "Frequency": "Daily"
      }
    },
    "ParallelExecution": true
  },
  "_LLM_NOTE": "LLM section configures the AI provider used by New-FGRiskProfile, New-FGRiskClassifiers, and New-FGCorrelationRuleset. Only anonymized structural data is sent to the LLM — no user names, emails, or identity data.",
  "LLM": {
    "Provider": "",
    "Model": "",
    "ApiKey": "",
    "_ApiKey_NOTE": "Set ApiKey here or use ApiKey_Encrypted for DPAPI encryption, or set ANTHROPIC_API_KEY / OPENAI_API_KEY env var"
  },
  "_RISKSCORING_NOTE": "RiskScoring section configures the identity risk scoring engine (New-FGRiskProfile / New-FGRiskClassifiers). Profiles and classifiers are stored in SQL by default. Use Export-FGRiskProfile / Export-FGRiskClassifiers to export to file for sharing.",
  "RiskScoring": {
    "Enabled": true,
    "CustomerDomain": "yourtenant.onmicrosoft.com",
    "Schedule": {
      "Enabled": true,
      "Time": "10:30",
      "Frequency": "Daily"
    }
  },
  "_ACCOUNTCORRELATION_NOTE": "AccountCorrelation section configures the daily account correlation run (Invoke-FGAccountCorrelation). The correlation ruleset is generated once with New-FGCorrelationRuleset and stored in SQL. The daily run re-correlates accounts based on the stored ruleset.",
  "AccountCorrelation": {
    "Enabled": true,
    "Schedule": {
      "Enabled": true,
      "Time": "11:00",
      "Frequency": "Daily"
    }
  },
  "_UI_NOTE": "UI section is created automatically by New-FGUI",
  "UI": {
    "WebAppName": "ui-12345",
    "AppServicePlanName": "ui-12345-plan",
    "Location": "northeurope",
    "Sku": "B2",
    "Scaling": "Optimum",
    "SqlSku": "S1",
    "EnvironmentSize": "Medium",
    "URL": "https://ui-12345.azurewebsites.net",
    "Auth": {
      "AppRegistrationName": "FortigiGraph-UI-ui-12345",
      "ClientId": "your-ui-app-client-id",
      "TenantId": "your-tenant-id"
    }
  }
}